PORT=5000
# Use a NEW database name (e.g. speaksphere_v2) so the tables are created cleanly
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speaksphere_v2
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
# Timezone used for "today", streaks and the daily quiz
APP_TZ=Asia/Kolkata

# --- AI (keys live ONLY here, never in the frontend) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# optional: set to "mock" to test without a key (anything else = auto)
AI_PROVIDER=

# --- Password reset email (optional). Without SMTP the reset link is printed in this console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SpeakSphere <no-reply@speaksphere.local>
